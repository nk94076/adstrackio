# ---------------------------------------------------------------------------
# AdstrackIO - PRODUCTION environment configuration template
#
# Copy this file to `.env.production` and fill in real values for your
# actual VPS deployment. NEVER commit the filled-in file — `.gitignore`
# already excludes `.env*` except `.env.example` and this template.
#
# Used by docker/docker-compose.production.yml via:
#   docker compose --env-file .env.production -f docker/docker-compose.production.yml ...
# See docs/deployment/production.md for the full deployment procedure.
# ---------------------------------------------------------------------------

# --- PostgreSQL container credentials -------------------------------------
# Consumed directly by the `postgres` service in
# docker-compose.production.yml. Keep these consistent with DATABASE_URL
# below — they describe the same database from two different places
# (the container's own startup vs. what apps/api and apps/tracker connect
# to), and Compose does not derive one from the other automatically.
POSTGRES_USER=adstrackio
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=adstrackio

# --- Redis container credentials ------------------------------------------
# Consumed directly by the `redis` service in
# docker-compose.production.yml (started with --requirepass). See the
# REDIS_URL comment below — still provisioned and required by the app's
# config schema, but not yet connected to by any package.
REDIS_PASSWORD=replace-with-a-long-random-password

# --- Application environment variables (packages/config/src/schema.ts) ---
# These are what apps/api and apps/tracker actually read at startup —
# validated eagerly, so a missing/placeholder value fails the container
# immediately rather than surfacing as a confusing runtime error later.

# Full connection string. Host "postgres" is the Docker Compose service
# name for the postgres container above, resolved over the private
# `adstrackio_internal` network — not localhost, and not published to the
# host at all (see docker-compose.production.yml).
DATABASE_URL=postgresql://adstrackio:replace-with-a-long-random-password@postgres:5432/adstrackio?schema=public

# Still validated as required at container startup but NOT actually
# connected to by any package yet — rate limiting (apps/api) uses
# @fastify/rate-limit's in-memory default store, and the only queue in
# this codebase is a minimal PostgreSQL-backed one (Phase 11's webhook
# delivery worker). Host "redis" is the Compose service name; not
# published to the host at all. Reserved for a future phase that needs
# real Redis-backed rate-limiting/queueing at multi-instance scale.
REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379

# Signs authentication session tokens (JWT). Generate a strong random
# value: openssl rand -base64 48
# Must be at least 32 characters and must NOT be a placeholder value —
# both are enforced at startup (packages/config/src/schema.ts), not just
# documented here.
AUTH_SECRET=replace-with-a-long-random-string-min-32-chars

# Optional. Salt used to one-way hash a click's IP address before storing
# it (apps/tracker never stores a raw IP). Falls back to AUTH_SECRET if
# left unset; set a separate value here to decouple IP-hash derivation
# from the session-signing secret. Generate the same way as AUTH_SECRET.
CLICK_IP_HASH_SALT=

# Optional. Leave unset unless your reverse proxy (the existing Hostinger
# Apache setup) is configured to inject a matching
# x-adstrackio-edge-secret header on every request it forwards to the
# tracker, AND to strip any client-supplied copy of that header first.
# Unset (the default) means COUNTRY routing conditions never match,
# regardless of what geo headers a request carries — a client can never
# forge trust just by sending one. See
# docs/architecture/rules-routing.md#country-signal-trust-boundary.
TRUSTED_EDGE_SECRET=

# The real public HTTPS URLs of each service, exactly as visitors/API
# consumers reach them THROUGH Apache — not the internal Docker container
# ports below. APP_URL is also the API's CORS allow-list origin
# (apps/api/src/plugins/security.ts): get this wrong and the dashboard
# cannot call the API at all.
APP_URL=https://app.yourdomain.com
API_URL=https://api.yourdomain.com
TRACKER_URL=https://track.yourdomain.com

# Browser-visible API base URL. This is a NEXT_PUBLIC_* variable, so
# Next.js inlines it into the dashboard's client-side JavaScript bundle
# AT BUILD TIME — it must be passed as a Docker build arg
# (`--build-arg NEXT_PUBLIC_API_URL=...`), not only set here, or set here
# for reference and passed through explicitly at build time. See
# apps/dashboard/Dockerfile and docs/deployment/production.md. Must match
# API_URL above.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Runtime environment. Governs `secure` on the session cookie
# (apps/api/src/modules/auth/auth.routes.ts) and log verbosity — must be
# "production" for a real deployment.
NODE_ENV=production

# Ports each process listens on INSIDE its container. These are what the
# Dockerfiles EXPOSE and what docker-compose.production.yml maps from —
# changing them here also means updating the compose file's port mappings.
API_PORT=4000
TRACKER_PORT=4100
