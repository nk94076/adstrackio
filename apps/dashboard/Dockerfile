#
# Production image for @adstrackio/dashboard. Not part of the
# Google-facing tracker surface — this is the internal, session-cookie
# authenticated admin UI.
#
# Build from the MONOREPO ROOT, e.g.:
#
#   docker build -f apps/dashboard/Dockerfile --target runtime -t adstrackio-dashboard \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.yourdomain.com .
#   docker run -p 127.0.0.1:3000:3000 adstrackio-dashboard
#
# Uses Next.js's `output: "standalone"` (see next.config.mjs) so the
# runtime image only needs the traced-as-used node_modules plus the
# compiled server, not the whole workspace.
#
# NEXT_PUBLIC_API_URL is baked in AT BUILD TIME (it is a `NEXT_PUBLIC_*`
# variable, inlined into the client bundle by `next build`) — pass it as
# a build arg, not a container runtime env var, or the dashboard will
# call the wrong API origin. See docs/deployment/production.md.

FROM node:20-alpine AS build
RUN corepack enable
WORKDIR /repo

ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NODE_ENV=production
# See apps/tracker/Dockerfile's ENV CI=true comment: this image doesn't
# run `pnpm prune`, but `pnpm install` itself can hit the same
# no-TTY modules-dir confirmation prompt (e.g. on lockfile/node_modules
# drift) — set consistently across every Dockerfile in this repo so no
# pnpm command anywhere in a `docker build` can block on stdin.
ENV CI=true

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec turbo run build --filter=@adstrackio/dashboard
# apps/dashboard has no public/ directory in this repo (no static assets
# checked in) — `next build` never creates one either, it only ever
# copies an existing public/ into .next/standalone's traced output.
# `COPY --from=` (unlike shell `cp`) hard-fails if its source path
# doesn't exist, so guarantee the path is present here (a no-op if a
# real public/ directory is ever added later, since `-p` doesn't
# clobber existing content) rather than committing an empty directory
# to the repo just to appease Docker.
RUN mkdir -p /repo/apps/dashboard/public

FROM node:20-alpine AS runtime
ENV NODE_ENV=production
# The Next.js standalone server.js this image runs binds to
# `process.env.HOSTNAME || '0.0.0.0'` (see .next/standalone/apps/dashboard/server.js,
# generated by `next build`). Docker sets HOSTNAME on every container to
# that container's own hostname by default (its short container ID
# unless overridden), which resolves via /etc/hosts to the container's
# private network IP — so with no override here, the server ends up
# listening ONLY on that one dynamic IP (e.g. 172.18.0.4:3000), not on
# 127.0.0.1, even though EXPOSE/the healthcheck/the compose port mapping
# all assume it does. Explicitly setting HOSTNAME=0.0.0.0 overrides
# Docker's per-container default so the server always binds every
# interface, regardless of what IP this container happens to get
# assigned on its network — this is NOT the container's IP hardcoded,
# it's the standard all-interfaces bind address.
ENV HOSTNAME=0.0.0.0
RUN addgroup -S adstrackio && adduser -S adstrackio -G adstrackio
WORKDIR /app

COPY --from=build /repo/apps/dashboard/.next/standalone ./
COPY --from=build /repo/apps/dashboard/.next/static ./apps/dashboard/.next/static
COPY --from=build /repo/apps/dashboard/public ./apps/dashboard/public

USER adstrackio
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["node", "apps/dashboard/server.js"]
