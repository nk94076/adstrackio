    "@adstrackio/shared": "workspace:*",
    "@fastify/helmet": "^13.0.1",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
