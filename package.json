{
  "name": "adstrackio",
  "private": true,
  "version": "0.1.0",
  "description": "AdstrackIO - performance marketing / attribution / click-tracking platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @adstrackio/database db:generate",
    "db:migrate": "pnpm --filter @adstrackio/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @adstrackio/database db:migrate:deploy",
    "db:studio": "pnpm --filter @adstrackio/database db:studio",
    "db:seed": "pnpm --filter @adstrackio/database db:seed",
    "compliance:test": "pnpm --filter @adstrackio/tracker compliance:test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
