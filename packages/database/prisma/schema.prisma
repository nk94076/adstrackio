// AdstrackIO — Phase 1 foundation data model.
//
// Design notes:
// - Entities marked "foundation only" exist so later phases can build on a
//   stable schema without a breaking migration. They intentionally do not
//   carry behavior that isn't implemented yet (e.g. no real bot detection
//   engine, no real redirect resolution, no DNS verification).
// - Click/BotEvent are event-oriented and privacy-conscious: raw IP
//   addresses are never stored, only a one-way hash.
// - See docs/architecture/data-model.md for the full rationale.

generator client {
  provider = "prisma-client-js"
  // Custom output (rather than the default node_modules/.prisma/client)
  // so the generated client is a plain, ordinary set of files living
  // inside this package — deterministically copied by `pnpm deploy`
  // (production runtime packaging, see apps/api/Dockerfile and
  // apps/tracker/Dockerfile) exactly like any other source file, with
  // no dependency on node_modules/@prisma/client's own postinstall
  // generate-on-install behavior, which does not reliably survive a
  // `pnpm deploy` re-resolve from the content-addressable store.
  output = "../generated/client"
  // "native" generates the engine for wherever `prisma generate` runs
  // (local dev, CI). The two "linux-musl*" targets generate the engine
  // binaries for the actual production runtime — apps/api/Dockerfile
  // and apps/tracker/Dockerfile build FROM node:20-alpine, which uses
  // musl libc (not the glibc "debian-openssl-3.0.x" engine "native"
  // alone would produce) — covering both common Docker platforms
  // (amd64 and arm64). Without this, only the "native" (glibc) engine
  // is generated, which cannot run on the Alpine-based production image
  // at all — a separate latent bug from the workspace-package
  // resolution issue this phase otherwise fixes.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum DomainSslStatus {
  NOT_CONFIGURED
  PENDING
  ACTIVE
  FAILED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Routing action for SUSPICIOUS/UNKNOWN-classified traffic (Phase 5: Bot
/// Detection Integration) — see packages/shared/src/bot-traffic-policy.ts.
enum BotTrafficPolicyAction {
  SAFE_PAGE
  TARGET
  BLOCK
}

enum TrackingLinkStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ConversionStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

enum RoutingRuleStatus {
  ACTIVE
  INACTIVE
}

/// Same three physical outcomes as BotTrafficPolicyAction (Phase 5) — a
/// RoutingRule never invents a fourth kind of destination. See
/// packages/shared/src/routing-rules.ts.
enum RoutingRuleAction {
  TARGET
  SAFE_PAGE
  BLOCK
}

enum AffiliatePartnerStatus {
  PENDING
  ACTIVE
  PAUSED
  ARCHIVED
}

enum BotClassification {
  UNKNOWN
  HUMAN
  SUSPICIOUS
  BOT
}

enum DeviceType {
  UNKNOWN
  DESKTOP
  MOBILE
  TABLET
  BOT
  OTHER
}

enum ReferralConfigurationType {
  NORMAL
  HIDE
  CUSTOM_PARTNER_ATTRIBUTION
}

enum ReferralConfigurationStatus {
  INACTIVE
  ACTIVE
}

enum ReferralProofReviewStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/// Permission scopes an ApiKey can carry (Phase 11: API + Integrations) —
/// see docs/api/api-keys.md. Deliberately a small flat set, not a
/// granular permissions matrix — the same restraint packages/auth/src/roles.ts
/// already applies to OrganizationRole. Orthogonal to OrganizationRole:
/// scopes gate WHAT an API key may call, not WHO is calling — see
/// apps/api/src/plugins/api-key-auth.ts.
enum ApiKeyScope {
  READ
  WRITE
  REPORTS
  CONVERSIONS
}

/// Lifecycle status of one queued webhook delivery attempt-set (Phase 11)
/// — see docs/api/webhooks.md#retries.
enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  EXHAUSTED
}

/// Whether a business-event outbox row has been fanned out into
/// WebhookDelivery rows yet (Phase 11) — see
/// docs/api/webhooks.md#outbox-and-delivery-architecture. Not the delivery
/// outcome itself (WebhookDeliveryStatus is): a PROCESSED OutboxEvent may
/// still have deliveries pending, retrying, or exhausted.
enum OutboxEventStatus {
  PENDING
  PROCESSED
}

// ---------------------------------------------------------------------------
// Identity & organizations
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships             OrganizationMember[]
  auditLogs               AuditLog[]              @relation("AuditLogActor")
  referralConfigurations  ReferralConfiguration[] @relation("ReferralConfigurationCreatedBy")
  referralProofsSubmitted ReferralProof[]         @relation("ReferralProofSubmittedBy")
  referralProofsReviewed  ReferralProof[]         @relation("ReferralProofReviewedBy")
  apiKeysCreated          ApiKey[]                @relation("ApiKeyCreatedBy")
  webhookEndpointsCreated WebhookEndpoint[]       @relation("WebhookEndpointCreatedBy")

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                OrganizationMember[]
  trackingDomains        TrackingDomain[]
  campaigns              Campaign[]
  destinations           Destination[]
  clicks                 Click[]
  conversions            Conversion[]
  referralConfigurations ReferralConfiguration[]
  auditLogs              AuditLog[]
  routingRules           RoutingRule[]
  affiliatePartners        AffiliatePartner[]
  campaignAffiliatePartners CampaignAffiliatePartner[]
  apiKeys                  ApiKey[]
  webhookEndpoints          WebhookEndpoint[]
  outboxEvents              OutboxEvent[]
  idempotencyRecords        IdempotencyRecord[]

  @@map("organizations")
}

/// Join model between User and Organization. Modelled as its own table (not
/// an implicit m2m) so a membership can carry a role today and additional
/// per-membership attributes later without a schema rewrite.
model OrganizationMember {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

// ---------------------------------------------------------------------------
// Tracking domain foundation
// ---------------------------------------------------------------------------

model TrackingDomain {
  id                      String                   @id @default(cuid())
  organizationId          String
  hostname                String                   @unique
  verificationStatus      DomainVerificationStatus @default(PENDING)
  verificationToken       String?
  verificationRequestedAt DateTime?
  verifiedAt              DateTime?
  sslStatus               DomainSslStatus          @default(NOT_CONFIGURED)
  isActive                Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns     Campaign[]
  trackingLinks TrackingLink[]

  @@index([organizationId])
  @@map("tracking_domains")
}

// ---------------------------------------------------------------------------
// Campaign / destination / tracking link foundation
// ---------------------------------------------------------------------------

/// The business target a campaign or tracking link ultimately points to.
/// Kept distinct from TrackingLink (the tracked identifier) and Click (the
/// individual event) so analytics can evolve independently of routing.
model Destination {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  url            String
  isActive       Boolean  @default(true)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns     Campaign[]
  trackingLinks TrackingLink[]

  @@index([organizationId])
  @@map("destinations")
}

model Campaign {
  id                      String                 @id @default(cuid())
  organizationId          String
  name                    String
  status                  CampaignStatus         @default(DRAFT)
  trackingDomainId        String?
  destinationId           String?
  /// Where the tracker sends traffic it classifies as BOT/automated,
  /// instead of the visible, request-supplied transparent redirection_url
  /// (Phase 3: Transparent Click Tracker). Server-configured only — never
  /// selectable by a request parameter. Null means "no safe page
  /// configured", in which case the tracker responds with a controlled
  /// 404 rather than guessing a destination.
  safePageUrl             String?
  /// Routing policy for SUSPICIOUS/UNKNOWN-classified traffic (Phase 5:
  /// Bot Detection Integration) — see
  /// packages/shared/src/bot-traffic-policy.ts. BOT is always routed to
  /// safePageUrl (or a controlled block if unset); HUMAN is always routed
  /// to the transparent destination — those two are not configurable.
  /// Defaults to TARGET, the implicit behavior every campaign already had
  /// before this field existed (the previous detection engine never
  /// produced SUSPICIOUS/UNKNOWN at all).
  suspiciousTrafficPolicy BotTrafficPolicyAction @default(TARGET)
  unknownTrafficPolicy    BotTrafficPolicyAction @default(TARGET)
  budgetAmount            Decimal?               @db.Decimal(12, 2)
  budgetCurrency          String?                @db.VarChar(3)
  startDate               DateTime?
  endDate                 DateTime?
  metadata                Json?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackingDomain TrackingDomain? @relation(fields: [trackingDomainId], references: [id])
  destination    Destination?    @relation(fields: [destinationId], references: [id])

  trackingLinks          TrackingLink[]
  clicks                 Click[]
  conversions            Conversion[]
  referralConfigurations ReferralConfiguration[]
  routingRules           RoutingRule[]
  affiliatePartnerAssignments CampaignAffiliatePartner[]

  @@index([organizationId])
  @@map("campaigns")
}

/// Represents a trackable link/URL identifier. Click resolution (matching
/// an inbound apps/tracker request's hostname+slug to this row) is
/// implemented by TrackingResolver (Phase 3: Transparent Click Tracker) —
/// see packages/shared/src/tracking-resolver.ts. Note: `destinationId`
/// below is administrative/informational only in Phase 3 — the tracker's
/// actual redirect target is the request's own validated `redirection_url`
/// parameter, per the Google Transparent Click Tracker architecture (see
/// docs/compliance/google-transparent-tracker.md). It is not silently
/// substituted for that parameter.
model TrackingLink {
  id               String             @id @default(cuid())
  campaignId       String
  trackingDomainId String
  destinationId    String
  slug             String
  status           TrackingLinkStatus @default(ACTIVE)
  /// Which single AffiliatePartner this link's clicks attribute to (Phase
  /// 9: Affiliate/Partner System) — a plain FK, deliberately NOT a second
  /// join table alongside CampaignAffiliatePartner (see
  /// docs/architecture/affiliate-partners.md). Null means "no partner
  /// attribution" (an ordinary, non-affiliate tracking link). When set,
  /// must reference a partner currently on this link's own campaign's
  /// roster (a CampaignAffiliatePartner row) — enforced in the service
  /// layer and backstopped by `enforce_tracking_link_affiliate_partner`
  /// (migration `20260902190000_affiliate_partner_system`). This is the
  /// single deterministic attribution point every Click through this link
  /// inherits — never a client-supplied value at click time.
  affiliatePartnerId String?
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  trackingDomain   TrackingDomain    @relation(fields: [trackingDomainId], references: [id], onDelete: Cascade)
  destination      Destination       @relation(fields: [destinationId], references: [id])
  affiliatePartner AffiliatePartner? @relation(fields: [affiliatePartnerId], references: [id])

  clicks      Click[]
  conversions Conversion[]

  @@unique([trackingDomainId, slug])
  @@index([campaignId])
  @@index([affiliatePartnerId])
  @@map("tracking_links")
}

// ---------------------------------------------------------------------------
// Event data: clicks, conversions, bot events
// ---------------------------------------------------------------------------

/// Append-only click event. Privacy-conscious by design: no raw IP address
/// or other directly-identifying fields are stored. botClassification/
/// botScore are a denormalized snapshot of the latest related BotEvent to
/// keep read queries fast; BotEvent remains the source of truth.
///
/// deviceType/browser/browserVersion/os/osVersion and country/region/city/
/// timezone are enrichment fields populated by apps/tracker at write time
/// (Phase 4: Click Analytics) via the UserAgentParser and GeoLocationProvider
/// abstractions in packages/shared — never guessed or backfilled elsewhere.
/// A parsing/lookup failure leaves the relevant fields null rather than
/// blocking the click write or the redirect; see
/// docs/architecture/click-analytics.md.
model Click {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String
  trackingLinkId String
  occurredAt     DateTime @default(now())

  ipHash    String?
  userAgent String? @db.Text
  referrer  String? @db.Text

  country  String?
  region   String?
  city     String?
  /// IANA timezone of the click's inferred location (e.g. "America/New_York"),
  /// from GeoLocationProvider — distinct from the analytics API's `timezone`
  /// query parameter used for time-bucketing. Null when no geo provider is
  /// configured (the default — see packages/shared/src/geo-location.ts).
  timezone String?

  deviceType     DeviceType? @default(UNKNOWN)
  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?

  botClassification BotClassification? @default(UNKNOWN)
  botScore          Float?

  /// Denormalized snapshot of the resolving TrackingLink's
  /// affiliatePartnerId at the moment this Click was written (Phase 9:
  /// Affiliate/Partner System) — never independently client-supplied and
  /// never updated afterward (`enforce_click_affiliate_partner_immutable`,
  /// migration `20260902190000_affiliate_partner_system`, is a cheap
  /// UPDATE-only trigger, not an INSERT-time cross-table check — see
  /// docs/architecture/affiliate-partners.md#tracker-performance for why
  /// insert-time verification was deliberately NOT added to this
  /// hot-path table). Trust comes from there being exactly one code path
  /// that ever writes a Click row (apps/tracker's recordClick), which
  /// derives this value from TrackingResolver's already-fetched result —
  /// the same trust model this table's other FK columns already rely on.
  affiliatePartnerId String?

  requestMetadata Json?

  createdAt DateTime @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  trackingLink     TrackingLink      @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  affiliatePartner AffiliatePartner? @relation(fields: [affiliatePartnerId], references: [id])

  conversions Conversion[]
  botEvents   BotEvent[]

  @@index([organizationId, occurredAt])
  @@index([trackingLinkId])
  @@index([trackingLinkId, occurredAt])
  @@index([campaignId])
  @@index([campaignId, occurredAt])
  @@index([affiliatePartnerId, occurredAt])
  @@map("clicks")
}

/// A reported conversion event (Phase 7: Conversion Tracking), always
/// attributed through a real Click — see docs/architecture/conversion-tracking.md
/// for the full design rationale.
///
/// campaignId/trackingLinkId/organizationId are denormalized from `click`
/// purely for query performance (indexed filtering/aggregation without a
/// join) — they are never independently client-supplied and can never
/// disagree with the referenced Click's own values. The service layer
/// derives them at creation time and never updates them afterward;
/// `enforce_conversion_click_attribution` (migration
/// `20260902130000_conversion_tracking`) additionally enforces this at the
/// database level as a backstop against any write that bypasses the
/// service layer (a raw SQL statement, a future admin tool, a bug) —
/// mirrors the pattern `enforce_referral_configuration_activation`
/// established for the referral-activation gate.
///
/// value/currency deliberately use the same Decimal(12,2)/VarChar(3)
/// representation already established by Campaign.budgetAmount/
/// budgetCurrency, rather than introducing a second monetary convention.
/// Both are nullable: not every conversion event is monetary (e.g. a
/// "signup" or "lead" event may carry no value) — see
/// docs/architecture/conversion-tracking.md#monetary-representation.
model Conversion {
  id                   String           @id @default(cuid())
  organizationId       String
  campaignId           String
  trackingLinkId       String
  clickId              String
  /// Free-text conversion/event type (e.g. "purchase", "signup", "lead") —
  /// deliberately not an enum: the set of meaningful event names is
  /// defined by each advertiser's own funnel, not by AdstrackIO.
  eventName            String
  status               ConversionStatus @default(PENDING)
  value                Decimal?         @db.Decimal(12, 2)
  currency             String?          @db.VarChar(3)
  /// Caller-supplied idempotency key, unique per organization (see
  /// @@unique below). Optional: a caller with no natural external ID of
  /// its own is not forced to invent one, but then gets no deduplication
  /// guarantee — see docs/architecture/conversion-tracking.md#deduplication.
  externalConversionId String?
  occurredAt           DateTime         @default(now())
  metadata             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  trackingLink TrackingLink @relation(fields: [trackingLinkId], references: [id])
  click        Click        @relation(fields: [clickId], references: [id])

  /// Postgres treats NULL as distinct from every other value (including
  /// another NULL) for uniqueness purposes, so this constraint only
  /// applies to conversions that actually supplied an externalConversionId
  /// — any number of conversions with a NULL externalConversionId coexist
  /// freely. See docs/architecture/conversion-tracking.md#deduplication.
  @@unique([organizationId, externalConversionId])
  @@index([organizationId, occurredAt])
  @@index([campaignId, occurredAt])
  @@index([trackingLinkId, occurredAt])
  @@index([clickId])
  @@index([status, occurredAt])
  @@map("conversions")
}

/// A campaign-scoped, priority-ordered routing rule (Phase 8: Rules &
/// Routing Engine) — see docs/architecture/rules-routing.md.
///
/// `conditions` is a JSON array of `{field, operator, value}` objects
/// (packages/shared/src/routing-rules.ts's `RoutingCondition`), validated
/// at write time by packages/validation/src/routing-rules.ts and bounded
/// (max 10 conditions per rule). This is deliberately NOT an arbitrary
/// expression language or eval'able code — the set of fields and operators
/// is a small closed enum, matching the same "no eval, typed and bounded"
/// posture Phase 7 established for Conversion.metadata.
///
/// `action` reuses the exact same TARGET/SAFE_PAGE/BLOCK outcomes the
/// tracker's redirect switch already executes for bot-policy routing (see
/// apps/tracker/src/modules/tracker/tracker.routes.ts) — a rule can never
/// name an arbitrary URL of its own. TARGET still means "follow the
/// request's own transparent redirection_url", never a rule-configured
/// destination — this is what keeps the Google Transparent Click Tracker
/// architecture (Phase 3) intact.
///
/// `priority` is a plain integer, unique per campaign (@@unique below) —
/// lower values are evaluated first. Uniqueness is enforced at the
/// database level specifically so evaluation order is never ambiguous:
/// there is no hidden tie-break rule to reason about (e.g. createdAt or
/// id order), because two rules on the same campaign can never share a
/// priority in the first place.
///
/// organizationId/campaignId are set once at creation from the
/// authenticated request path (never client-body-supplied) and never
/// updated afterward; `enforce_routing_rule_campaign_organization`
/// (migration `20260902170000_rules_routing_engine`) enforces both facts
/// at the database level as a backstop, mirroring the pattern
/// `enforce_conversion_click_attribution` established in Phase 7.
model RoutingRule {
  id             String            @id @default(cuid())
  organizationId String
  campaignId     String
  name           String
  status         RoutingRuleStatus @default(ACTIVE)
  priority       Int
  conditions     Json
  action         RoutingRuleAction
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, priority])
  @@index([campaignId, status, priority])
  @@index([organizationId])
  @@map("routing_rules")
}

/// An external affiliate/partner an organization drives tracked traffic
/// through (Phase 9: Affiliate/Partner System) — see
/// docs/architecture/affiliate-partners.md.
///
/// Deliberately distinct from ReferralConfiguration (Phase 1): that model
/// controls how AdstrackIO's own internal attribution pipeline LABELS
/// traffic (referrer header spoofing/hiding) — it is not a real business
/// entity. AffiliatePartner is an actual affiliate/partner that gets
/// assigned to campaigns (CampaignAffiliatePartner) and whose tracking
/// links (TrackingLink.affiliatePartnerId) produce Clicks attributed back
/// to them. This phase does not touch ReferralConfiguration.
///
/// externalId is optional and unique per organization, not globally — the
/// same NULL-is-distinct Postgres uniqueness semantics
/// Conversion.externalConversionId already established (Phase 7): any
/// number of partners with a NULL externalId coexist freely within one
/// organization, and the same externalId value is free to reuse across
/// different organizations.
model AffiliatePartner {
  id             String                 @id @default(cuid())
  organizationId String
  name           String
  externalId     String?
  email          String?
  status         AffiliatePartnerStatus @default(PENDING)
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  campaignAssignments CampaignAffiliatePartner[]
  trackingLinks       TrackingLink[]
  clicks              Click[]

  @@unique([organizationId, externalId])
  @@index([organizationId, status])
  @@map("affiliate_partners")
}

/// Join model: which AffiliatePartners are authorized to run traffic on a
/// given Campaign (Phase 9) — the roster/authorization relationship the
/// campaign-scoped assignment API manages (POST/DELETE
/// .../campaigns/:campaignId/affiliate-partners/:partnerId). This is
/// deliberately the ONLY join table Phase 9 introduces: it does not by
/// itself determine which single partner a given Click attributes to —
/// that is TrackingLink.affiliatePartnerId, a plain FK rather than a
/// second join table (TrackingLinkAffiliatePartner), so a click's
/// attribution is always exactly one deterministic value, never a set to
/// disambiguate at read time. See
/// docs/architecture/affiliate-partners.md#assignment-design for the full
/// rationale.
///
/// organizationId is denormalized from campaignId purely for query
/// performance and IDOR-check convenience, mirroring Conversion/
/// RoutingRule's own established denormalization pattern; it is derived
/// and locked by `enforce_campaign_affiliate_partner_organization`
/// (migration `20260902190000_affiliate_partner_system`), never
/// independently client-supplied. That same trigger also verifies the
/// referenced AffiliatePartner belongs to the same organization as the
/// Campaign — the actual cross-org-assignment backstop.
model CampaignAffiliatePartner {
  id                 String   @id @default(cuid())
  organizationId     String
  campaignId         String
  affiliatePartnerId String
  createdAt          DateTime @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign         Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  affiliatePartner AffiliatePartner @relation(fields: [affiliatePartnerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, affiliatePartnerId])
  @@index([organizationId])
  @@index([affiliatePartnerId])
  @@map("campaign_affiliate_partners")
}

/// Foundation model only. Classification/scoring is expected to be produced
/// by the product's existing/planned bot-detection engine and written here
/// through a single ingestion interface — see
/// packages/shared/src/bot-detection.ts. No detection logic lives in Phase 1.
model BotEvent {
  id              String            @id @default(cuid())
  clickId         String
  classification  BotClassification
  score           Float?
  reasonCodes     String[]
  detectionSource String
  occurredAt      DateTime          @default(now())
  metadata        Json?
  createdAt       DateTime          @default(now())

  click Click @relation(fields: [clickId], references: [id], onDelete: Cascade)

  @@index([clickId])
  @@map("bot_events")
}

// ---------------------------------------------------------------------------
// Referral attribution foundation
// ---------------------------------------------------------------------------

/// Internal configuration of how AdstrackIO records referral/attribution
/// data for a campaign. This does NOT spoof outbound HTTP Referer headers;
/// it controls how the platform's own internal attribution pipeline labels
/// traffic. CUSTOM_PARTNER_ATTRIBUTION configurations are gated by an
/// approved ReferralProof — enforced in the service layer, see
/// apps/api/src/modules/referrals/referral-configurations.service.ts.
model ReferralConfiguration {
  id                  String                      @id @default(cuid())
  organizationId      String
  campaignId          String?
  type                ReferralConfigurationType
  status              ReferralConfigurationStatus @default(INACTIVE)
  customReferrerValue String?
  createdById         String
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])
  createdBy    User         @relation("ReferralConfigurationCreatedBy", fields: [createdById], references: [id])

  proofs ReferralProof[]

  @@index([organizationId])
  @@map("referral_configurations")
}

model ReferralProof {
  id                      String                    @id @default(cuid())
  referralConfigurationId String
  documentReference       String?
  evidenceUrl             String?
  submittedById           String
  reviewStatus            ReferralProofReviewStatus @default(PENDING)
  reviewedById            String?
  reviewedAt              DateTime?
  rejectionReason         String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  referralConfiguration ReferralConfiguration @relation(fields: [referralConfigurationId], references: [id], onDelete: Cascade)
  submittedBy           User                  @relation("ReferralProofSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy            User?                 @relation("ReferralProofReviewedBy", fields: [reviewedById], references: [id])

  @@index([referralConfigurationId])
  @@map("referral_proofs")
}

// ---------------------------------------------------------------------------
// Audit logging
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation("AuditLogActor", fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// API + Integrations (Phase 11) — see docs/api/overview.md and
// docs/architecture/api-integrations.md for the full design.
// ---------------------------------------------------------------------------

/// An organization-scoped credential for the public /api/v1 surface (Phase
/// 11). The raw secret is never persisted — only `keyPrefix` (a short,
/// non-secret slice of the random secret, plaintext, used purely to look
/// the row up in O(1) before verifying) and `keyHash` (a SHA-256 digest of
/// the FULL raw key, compared with a constant-time comparison — see
/// packages/auth/src/api-key.ts). Unlike User.passwordHash, this
/// deliberately does NOT use argon2: a user password is low-entropy and
/// needs a slow, memory-hard KDF to resist offline guessing, but an API
/// key secret is 256 bits of crypto.randomBytes — already unguessable — so
/// hashing it with a deliberately slow KDF would only add ~100ms+ of
/// self-inflicted latency (and a cheap CPU-exhaustion vector) to every
/// single public API request for no security benefit. See
/// docs/api/api-keys.md#hashing for the full rationale.
///
/// organizationId is set once at creation from the authenticated session's
/// own membership-checked URL path and never updated afterward — the same
/// IDOR boundary every other organization-scoped model in this codebase
/// already relies on.
model ApiKey {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  keyPrefix      String        @unique
  keyHash        String
  scopes         ApiKeyScope[]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation("ApiKeyCreatedBy", fields: [createdBy], references: [id])

  @@index([organizationId])
  @@map("api_keys")
}

/// An organization-configured HTTP destination that receives signed
/// webhook deliveries for the event types it subscribes to (Phase 11) —
/// see docs/api/webhooks.md.
///
/// `secretEncrypted` holds the HMAC signing secret encrypted at rest
/// (AES-256-GCM, keyed by a value derived from AUTH_SECRET — see
/// packages/auth/src/secret-box.ts) rather than a one-way hash: unlike
/// ApiKey, this secret must be *retrievable* server-side, because the
/// server itself has to reproduce the exact same HMAC-SHA256 signature on
/// every outgoing delivery (the same reason Stripe/GitHub webhook secrets
/// are retrievable server-side, not one-way hashed). Encryption-at-rest
/// protects against a raw database dump; it does not protect against a
/// compromise of the running API process itself, which could always
/// decrypt secrets it holds the key to reconstruct — see
/// docs/api/webhooks.md#secret-storage for this documented boundary.
/// Never returned by any API response after the create/rotate call that
/// generated it.
///
/// `subscribedEvents` is validated against the closed
/// packages/shared/src/webhook-events.ts allowlist at write time — never
/// an arbitrary string a client can inject as a fake event type.
model WebhookEndpoint {
  id               String    @id @default(cuid())
  organizationId   String
  name             String
  url              String
  secretEncrypted  String
  active           Boolean   @default(true)
  subscribedEvents String[]
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastDeliveryAt   DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User              @relation("WebhookEndpointCreatedBy", fields: [createdBy], references: [id])
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_endpoints")
}

/// The transactional outbox (Phase 11): one row per real business-lifecycle
/// event, written in the SAME database transaction as the mutation it
/// describes (see apps/api/src/modules/webhooks/outbox.service.ts's
/// `publishEvent`, called from conversions/affiliate-partners/campaigns/
/// tracking-links service functions immediately alongside their existing
/// `writeAuditLog` call). This is what makes event emission atomic with
/// the mutation: either both the business row and this event row commit
/// together, or neither does — there is no window where the DB write
/// succeeds but the event is lost, nor one where an event fires for a
/// mutation that then rolls back.
///
/// Duplicate-event prevention deliberately does NOT rely on a dedupe key
/// on this table. `publishEvent` is only ever called from the same
/// branch of each service function that also writes an audit-log entry —
/// the branch that runs ONLY when a real state transition actually
/// happens (see e.g. conversions.service.ts's transitionConversionStatus:
/// a same-target idempotent retry returns early before reaching either
/// call). A retried HTTP request that resolves to a no-op therefore
/// produces neither a duplicate audit entry NOR a duplicate outbox event,
/// for the same underlying reason — no new independent dedupe mechanism
/// needed here.
///
/// A background worker (apps/api/src/modules/webhooks/webhook-delivery-worker.ts)
/// fans PENDING rows out into WebhookDelivery rows (one per subscribed,
/// active WebhookEndpoint in the event's organization) and marks the row
/// PROCESSED — this fan-out is itself idempotent via WebhookDelivery's own
/// `@@unique([webhookEndpointId, eventId])` constraint, so re-scanning an
/// already-fanned-out event is always safe.
model OutboxEvent {
  id             String            @id @default(cuid())
  organizationId String
  /// One of packages/shared/src/webhook-events.ts's WEBHOOK_EVENT_TYPES
  /// (e.g. "conversion.approved"), plus the reserved "webhook.test" value
  /// used only by the webhook test-send endpoint. Deliberately a plain
  /// String, not a Prisma enum: Postgres enum labels cannot contain a
  /// literal "." and the wire-format event `type` (see
  /// docs/api/webhooks.md#payload) must read exactly "conversion.approved",
  /// not a re-cased identifier — validated at the application layer
  /// instead (every write site is internal service code, never a
  /// client-supplied value).
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  processedAt   DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([status, createdAt])
  @@index([organizationId])
  @@map("outbox_events")
}

/// One delivery job for one (WebhookEndpoint, OutboxEvent) pair (Phase 11)
/// — see docs/api/webhooks.md#retries. Retries update THIS row in place
/// (incrementing `attempt`, moving `nextAttemptAt` forward with
/// exponential backoff) rather than inserting a new row per attempt, which
/// is what the unique constraint below actually protects: the fan-out
/// step can safely run more than once for the same event (e.g. if the
/// worker crashes mid-scan) without ever producing two competing delivery
/// jobs for the same endpoint+event.
///
/// statuses: PENDING (queued or awaiting its next retry — see
/// `nextAttemptAt`), DELIVERED (terminal success), FAILED (terminal —
/// the destination returned a non-retryable 4xx), EXHAUSTED (terminal —
/// ran out of retries against a retryable failure). See
/// docs/api/webhooks.md#retries for the exact retryable/non-retryable
/// status-code split.
model WebhookDelivery {
  id                  String                @id @default(cuid())
  webhookEndpointId   String
  eventId             String
  attempt             Int                   @default(0)
  status              WebhookDeliveryStatus @default(PENDING)
  responseStatus      Int?
  responseBodySnippet String?
  deliveredAt         DateTime?
  nextAttemptAt       DateTime              @default(now())
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  event           OutboxEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([webhookEndpointId, eventId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// Backs the `Idempotency-Key` request header (Phase 11) — see
/// docs/api/api-keys.md#idempotency for the full design and its
/// relationship to Conversion.externalConversionId.
///
/// There is deliberately no `status` column. A row is only ever inserted
/// as part of the SAME database transaction that also performs the
/// underlying mutation and records its result (see
/// apps/api/src/modules/idempotency/idempotency.service.ts's
/// `withIdempotencyKey`) — so if that transaction rolls back (the request
/// was invalid, a downstream check failed), the insert rolls back with it
/// and the row never becomes visible to any other transaction at all. Any
/// row another request can ever actually read is therefore, by
/// construction, always for a fully-completed prior request — "PENDING"
/// is not a state any reader can ever observe, so it was not worth
/// modeling.
///
/// Concurrency safety comes from the `@@unique` constraint below, not
/// from application-level locking: Postgres blocks a second concurrent
/// INSERT of the same (organizationId, scope, key) until the first
/// transaction commits or rolls back, then either raises a unique
/// violation (first committed — caller replays the stored response) or
/// succeeds outright (first rolled back — caller proceeds normally). This
/// is the same guarantee every unique-constraint-backed dedupe path in
/// this codebase already relies on (e.g.
/// conversions_organizationId_externalConversionId_key).
model IdempotencyRecord {
  id             String   @id @default(cuid())
  organizationId String
  /// Which mutation this key is scoped to (e.g. "conversion.create") —
  /// namespacing so the same client-chosen key string can be reused
  /// across different endpoints without colliding.
  scope          String
  key            String
  /// SHA-256 hex digest of the canonicalized (stable-key-order) request
  /// body — lets a replay of the identical request be distinguished from
  /// a conflicting reuse of the same key with a different payload.
  requestHash    String
  resourceType   String?
  resourceId     String?
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, key])
  @@map("idempotency_records")
}
