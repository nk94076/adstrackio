# ---------------------------------------------------------------------------
# AdstrackIO - environment configuration template
# Copy this file to .env and fill in real values for local development.
# Never commit a filled-in .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (packages/database)
DATABASE_URL="postgresql://adstrackio:adstrackio@localhost:5432/adstrackio?schema=public"

# Redis connection string, used by BullMQ job queues (future phases) and
# API-level rate limiting.
REDIS_URL="redis://localhost:6379"

# Secret used to sign authentication session tokens (JWT). Generate a strong
# random value for real environments, e.g.: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"

# Public URL of the dashboard (Next.js) application.
APP_URL="http://localhost:3000"

# Public URL of the API (Fastify) application.
API_URL="http://localhost:4000"

# Public URL of the tracker service boundary (Fastify, future redirect engine).
TRACKER_URL="http://localhost:4100"

# Browser-visible API base URL used by apps/dashboard (Next.js). Must match
# API_URL above for local development.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Runtime environment: development | test | production
NODE_ENV="development"

# Port the API process listens on.
API_PORT=4000

# Port the tracker process listens on.
TRACKER_PORT=4100
