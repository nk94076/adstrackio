# ---------------------------------------------------------------------------
# AdstrackIO - environment configuration template
# Copy this file to .env and fill in real values for local development.
# Never commit a filled-in .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (packages/database)
DATABASE_URL="postgresql://adstrackio:adstrackio@localhost:5432/adstrackio?schema=public"

# Redis connection string. Currently validated at startup as a required
# config value but NOT actually connected to by any package yet — rate
# limiting (apps/api) uses @fastify/rate-limit's in-memory default store,
# and there is no job queue in this codebase (Phase 11's webhook delivery
# worker uses a minimal PostgreSQL-backed queue instead — see
# docs/api/webhooks.md#delivery-architecture). Reserved as Phase-1
# foundation for a future phase that needs real Redis-backed
# rate-limiting/queueing at multi-instance scale.
REDIS_URL="redis://localhost:6379"

# Secret used to sign authentication session tokens (JWT). Generate a strong
# random value for real environments, e.g.: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"

# Public URL of the dashboard (Next.js) application.
APP_URL="http://localhost:3000"

# Public URL of the API (Fastify) application.
API_URL="http://localhost:4000"

# Public URL of the tracker service boundary (Fastify, future redirect engine).
TRACKER_URL="http://localhost:4100"

# Browser-visible API base URL used by apps/dashboard (Next.js). Must match
# API_URL above for local development.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Runtime environment: development | test | production
NODE_ENV="development"

# Port the API process listens on.
API_PORT=4000

# Port the tracker process listens on.
TRACKER_PORT=4100

# Optional. Salt used to one-way hash a click's IP address before storing
# it (apps/tracker never stores a raw IP). Falls back to AUTH_SECRET if
# unset; set a separate value in production if you want IP-hash derivation
# decoupled from the session-signing secret.
# CLICK_IP_HASH_SALT="replace-with-a-long-random-string"

# Optional. Shared secret proving a request actually passed through your
# CDN/edge, before apps/tracker will trust ANY geo header on it
# (cf-ipcountry / x-vercel-ip-country / cloudfront-viewer-country) for
# Rules & Routing Engine COUNTRY conditions. Unset by default: with no
# secret configured, COUNTRY never matches for any request, regardless of
# which geo headers it carries — a client can never forge trust just by
# sending a geo header itself. To enable COUNTRY routing, generate a long
# random value here AND configure your CDN/edge to inject it as the
# x-adstrackio-edge-secret request header on every request it forwards to
# this service (and to strip/overwrite any client-supplied copy of that
# header first). See docs/architecture/rules-routing.md#country-signal-trust-boundary
# for exact per-CDN setup instructions.
# TRUSTED_EDGE_SECRET="replace-with-a-long-random-string"
